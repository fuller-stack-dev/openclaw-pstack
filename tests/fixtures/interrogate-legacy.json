    "name": "interrogate-reviewer",
    "schema": {
      "description": "One independent read-only reviewer. The lead, not the reviewer, assigns the four verdict buckets.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "findings",
        "lenses",
        "testAssessment"
      ],
      "properties": {
        "findings": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "severity",
              "title",
              "location",
              "mechanism",
              "evidence",
              "inference"
            ],
            "properties": {
              "severity": {
                "type": "string",
                "enum": [
                  "critical",
                  "warning",
                  "nit"
                ]
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "location": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              },
              "mechanism": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "evidence": {
                "type": "string",
                "minLength": 1,
                "maxLength": 4096
              },
              "suggestion": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2048
              },
              "inference": {
                "type": "boolean"
              }
            }
          }
        },
        "lenses": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "lens",
              "disposition",
              "note"
            ],
            "properties": {
              "lens": {
                "type": "string",
                "enum": [
                  "correctness-and-edge-paths",
                  "idempotency-and-concurrency",
                  "root-cause",
                  "structural-integrity",
                  "behavioral-verification",
                  "complexity",
                  "security"
                ]
              },
              "disposition": {
                "type": "string",
                "enum": [
                  "covered",
                  "not-applicable"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              }
            }
          }
        },
        "testAssessment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      }
    }
  },
